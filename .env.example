# Required: Letta API key from https://app.letta.com
LETTA_API_KEY=your-api-key

# Optional: Use a specific Letta agent (auto-created on first run if not set)
# LETTA_AGENT_ID=agent-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Self-hosted Letta server (defaults to https://api.letta.com)
# LETTA_BASE_URL=http://localhost:8283

# Optional: Override the model used by the Subconscious agent
# LETTA_MODEL=anthropic/claude-sonnet-4-5

# Optional: Override context window size in tokens (useful with large-context models)
# LETTA_CONTEXT_WINDOW=1048576

# Optional: Client-side tool access for the Subconscious agent (read-only, full, off)
# LETTA_SDK_TOOLS=read-only
